    "/webhooks/authorize": {
      "post": {
        "summary": "Ask whether a version may be deployed to an environment",
        "description": "The deployment gate (ADR-012). Evidence detects an ungoverned production deployment after it shipped; this refuses one before it happens.\n\nOnly the declared production environment is gated. A version legitimately reaches staging before it is released, and refusing there would block every pre-release deploy and teach people to switch the gate off \u2014 at which point it protects production either.\n\nA release record existing is not permission: rejected, deferred, or still awaiting approval is refused. Callers should fail closed and treat a refusal, an error, and an unreachable server alike as 'do not deploy'.",
        "operationId": "authorizeDeployment",
        "tags": [
          "Deployments"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "apply",
                      "probe"
                    ],
                    "description": "probe is a readiness check: always allowed, decides nothing, and must not be recorded as a deployment decision."
                  },
                  "environment": {
                    "type": "string",
                    "example": "production"
                  },
                  "version": {
                    "type": "string",
                    "example": "1.4.0",
                    "description": "A production request without it is refused: relicta cannot check what it is not told. A leading v is tolerated, since deployers read versions off image tags."
                  },
                  "target_ref": {
                    "type": "string",
                    "description": "Recorded as evidence rather than used to decide.",
                    "example": "k8s/prod/api"
                  },
                  "actor_id": {
                    "type": "string"
                  },
                  "actor_kind": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A decision. Note that allowed=false is a successful response: it is governance answering no, which a caller should distinguish from a 5xx meaning governance could not answer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "allowed"
                  ],
                  "properties": {
                    "allowed": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "description": "Written for whoever has to act on a refusal.",
                      "example": "relicta has no release record for version 9.9.9: it was not governed, so it must not reach production"
                    },
                    "evidence": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "What the decision rested on \u2014 release ID, decision, risk score, who released it \u2014 so an audit trail says why a deployment was permitted rather than only that it was."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unreadable or invalid request body"
          },
          "401": {
            "description": "Invalid or missing signature while a secret is configured"
          },
          "503": {
            "description": "The store or release history could not be read, so no decision could be made. Never answered as allowed: a caller cannot distinguish allow-because-governed from allow-because-broken."
          }
        }
      }
    },
    "/webhooks/deployments": {
      "post": {
        "summary": "Record that a version reached an environment",
        "description": "Deployment evidence, reported by whatever performed the deployment (ADR-012). Only the deployer knows the difference between a deployment being requested and one succeeding, and a GitOps controller reconciling in a cluster cannot run the CLI. Deliberately generic: any deployer posting this schema is a first-class client.\n\nThe repository is resolved server-side and is not accepted from the payload, so a reporter cannot write governance records attributed to a different repository.\n\nSign the body with HMAC-SHA256 in X-Relicta-Signature when RELICTA_WEBHOOK_SECRET is set.",
        "operationId": "recordDeployment",
        "tags": [
          "Deployments"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "environment",
                  "version"
                ],
                "properties": {
                  "environment": {
                    "type": "string",
                    "description": "Where the version went.",
                    "example": "production"
                  },
                  "version": {
                    "type": "string",
                    "example": "1.4.0"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "succeeded",
                      "failed",
                      "rolled_back"
                    ],
                    "default": "succeeded",
                    "description": "An unrecognized value is refused rather than stored: a value counted as neither success nor failure biases every rate derived from it."
                  },
                  "deployed_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Defaults to now, which is accurate for a controller reporting its own sync as it finishes."
                  },
                  "duration_ms": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "reference": {
                    "type": "string",
                    "description": "The reporter's own record \u2014 a rollout ID, a CI run URL \u2014 so a claim can be followed to its source."
                  },
                  "release_id": {
                    "type": "string",
                    "description": "Absent is meaningful rather than missing: a deployment with no release is a version that reached an environment without passing through governance."
                  },
                  "actor_id": {
                    "type": "string"
                  },
                  "actor_kind": {
                    "type": "string",
                    "description": "Defaults to system: a deployment reported here was performed by a machine unless the reporter says otherwise."
                  },
                  "provenance": {
                    "type": "string",
                    "enum": [
                      "reported",
                      "inferred",
                      "manual"
                    ],
                    "default": "reported",
                    "description": "A reporter deducing a deployment from desired state should say inferred, so an auditor can weigh a controller's own report differently from a guess."
                  },
                  "metadata": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Deployment recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recorded": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    },
                    "repository": {
                      "type": "string"
                    },
                    "environment": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "outcome": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unreadable body, or a field value that is not recognized"
          },
          "401": {
            "description": "Invalid or missing signature while a secret is configured"
          },
          "503": {
            "description": "The governance store could not be opened"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token obtained from /auth/login"
      }
    },
    "parameters": {
      "limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum number of items per page (1-100)",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "cursor": {
        "name": "cursor",
        "in": "query",
        "description": "Opaque cursor for cursor-based pagination",
        "schema": {
          "type": "string"
        }
      },
      "page": {
        "name": "page",
        "in": "query",
        "description": "Page number for legacy offset pagination",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "pageSize": {
        "name": "page_size",
        "in": "query",
        "description": "Page size for legacy offset pagination (1-100)",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      },
      "releaseId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Release run ID",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable error message"
          },
          "code": {
            "type": "string",
            "description": "Machine-readable error code",
            "enum": [
              "BAD_REQUEST",
              "INVALID_JSON",
              "VALIDATION_FAILED",
              "MISSING_FIELD",
              "UNAUTHORIZED",
              "INVALID_CREDENTIALS",
              "TOKEN_EXPIRED",
              "TOKEN_INVALID",
              "FORBIDDEN",
              "NOT_FOUND",
              "RELEASE_NOT_FOUND",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE",
              "AUTH_NOT_CONFIGURED"
            ]
          },
          "details": {
            "description": "Additional error details"
          },
          "request_id": {
            "type": "string",
            "description": "Unique request identifier for tracing"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "go_version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "uptime": {
            "type": "string",
            "example": "1h30m0s"
          },
          "version": {
            "type": "string",
            "example": "v1.2.0"
          },
          "go_version": {
            "type": "string",
            "example": "go1.22.0"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "description": "Token TTL in seconds"
          }
        }
      },
      "Release": {
        "type": "object",
        "required": [
          "id",
          "state",
          "base_ref",
          "head_ref",
          "created_at",
          "updated_at",
          "commit_count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "planned",
              "versioned",
              "notes_ready",
              "approved",
              "published",
              "failed",
              "canceled"
            ]
          },
          "base_ref": {
            "type": "string"
          },
          "head_ref": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "next_version": {
            "type": "string"
          },
          "bump_type": {
            "type": "string",
            "enum": [
              "major",
              "minor",
              "patch"
            ]
          },
          "risk_score": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "approved_by": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "commit_count": {
            "type": "integer"
          },
          "change_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "release_notes": {
            "type": "string"
          }
        }
      },
      "GovernanceDecision": {
        "type": "object",
        "required": [
          "id",
          "release_id",
          "decision",
          "risk_score",
          "risk_level",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "release_id": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "deny",
              "require_review",
              "pending"
            ]
          },
          "risk_score": {
            "type": "number",
            "format": "double"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "factors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "actor_id": {
            "type": "string"
          },
          "actor_kind": {
            "type": "string"
          },
          "policy_matched": {
            "type": "string"
          },
          "requires_review": {
            "type": "boolean"
          },
          "review_reason": {
            "type": "string"
          }
        }
      },
      "Actor": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "release_count",
          "success_rate",
          "average_risk_score",
          "reliability_score",
          "last_seen",
          "trust_level"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "human",
              "ci",
              "ai_agent"
            ]
          },
          "name": {
            "type": "string"
          },
          "release_count": {
            "type": "integer"
          },
          "success_rate": {
            "type": "number",
            "format": "double"
          },
          "average_risk_score": {
            "type": "number",
            "format": "double"
          },
          "reliability_score": {
            "type": "number",
            "format": "double"
          },
          "last_seen": {
            "type": "string",
            "format": "date-time"
          },
          "trust_level": {
            "type": "string",
            "enum": [
              "trusted",
              "standard",
              "probation"
            ]
          }
        }
      },
      "Approval": {
        "type": "object",
        "required": [
          "release_id",
          "version",
          "risk_score",
          "risk_level",
          "requires_review",
          "submitted_at",
          "commit_count"
        ],
        "properties": {
          "release_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "risk_score": {
            "type": "number",
            "format": "double"
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "requires_review": {
            "type": "boolean"
          },
          "review_reason": {
            "type": "string"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "submitted_by": {
            "type": "string"
          },
          "commit_count": {
            "type": "integer"
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "required": [
          "id",
          "type",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "release_id": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "RiskTrend": {
        "type": "object",
        "required": [
          "date",
          "risk_score",
          "releases"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "risk_score": {
            "type": "number",
            "format": "double"
          },
          "releases": {
            "type": "integer"
          }
        }
      },
      "FactorDistribution": {
        "type": "object",
        "required": [
          "factor",
          "count",
          "percentage"
        ],
        "properties": {
          "factor": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "percentage": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CursorPagination": {
        "type": "object",
        "required": [
          "data",
          "total",
          "limit",
          "has_more"
        ],
        "properties": {
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "next_cursor": {
            "type": "string"
          },
          "prev_cursor": {
            "type": "string"
          },
          "has_more": {
            "type": "boolean"
          }
        }
      },
      "PaginatedReleases": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CursorPagination"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          }
        ]
      },
      "PaginatedGovernanceDecisions": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CursorPagination"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/GovernanceDecision"
                }
              }
            }
          }
        ]
      },
      "PaginatedActors": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CursorPagination"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Actor"
                }
              }
            }
          }
        ]
      },
      "PaginatedApprovals": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CursorPagination"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Approval"
                }
              }
            }
          }
        ]
      },
      "PaginatedAuditEvents": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CursorPagination"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AuditEvent"
                }
              }
            }
          }
        ]
      }
    }
  }
}
