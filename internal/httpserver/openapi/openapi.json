    "/approvals/{id}/approve": {
      "post": {
        "summary": "Approve a pending release",
        "operationId": "approveRelease",
        "tags": [
          "Approvals"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/releaseId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "justification": {
                    "type": "string"
                  },
                  "force": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Release approved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "approved": {
                      "type": "boolean"
                    },
                    "run_id": {
                      "type": "string"
                    },
                    "plan_hash": {
                      "type": "string"
                    },
                    "approved_by": {
                      "type": "string"
                    },
                    "version_next": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
