{
  "name": "relicta-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --fix --ignore-path .gitignore",
    "typecheck": "vue-tsc --noEmit",
    "test:a11y": "playwright test --config=playwright.config.ts",
    "test:a11y:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "chart.js": "^4.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
    "radix-vue": "^1.9.11",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9",
    "@playwright/test": "^1.62.1",
    "@axe-core/playwright": "^4.12.1"
  }
}
